rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: games
    // Fields: id, seasonId, homeTeamId, awayTeamId, createdAt
    //
    // Collection: videos
    // Fields: youtubeId, videoId, gameId, title, createdAt
    //
    // Collection: events
    // Fields: videoId, gameId, userId, type, videoTime, createdAt, votes, status, playerId, subPlayerId, teamId
    // userId is a Firebase uid and is the ONLY identity stored anywhere. There are no display
    // names, handles, or profiles — the app renders "User 048293", derived from the uid.
    // Event types: goal, shot, assist, foul, card, substitution, control_change, turnover, takeaway, block, gameStart, gamePause, gameResume, gameEnd, flag_released, seeker_enters, flag_catch
    // teamId: required for team-attributable events; null on control_change means no team has possession
    //
    // Collection: players
    // Fields: firstName, lastName, preferredName, nickname, createdAt
    // gender: internal roster-eligibility field ('M' | 'W' | 'NB'), not surfaced in any UI
    //
    // Collection: teams
    // Fields: name, createdAt
    //
    // Collection: seasons
    // Fields: name, league (optional), year (optional), description (optional), id (optional), createdAt
    //
    // Collection: rosters
    // Fields: teamId, seasonId, createdAt
    //
    // Collection: rosters/{rosterId}/players
    // Fields: playerId, number, createdAt
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email == "andrew.axtell@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Four tiers, matching the app: user < author < moderator < admin.
    //
    // Only moderators are stored, and they are stored as UIDS, never emails — appConfig/roles
    // is world-readable, so an email list there would publish the contributor roster.
    function isModerator() {
      return isAdmin() ||
        (
          isAuthenticated() &&
          exists(/databases/$(database)/documents/appConfig/roles) &&
          get(/databases/$(database)/documents/appConfig/roles).data.moderators.hasAny([request.auth.uid])
        );
    }

    // A real Google account. Every visitor is signed in — anonymous sessions exist so that
    // voting and suggesting work without a sign-in wall — so "is authenticated" no longer
    // means "is a person with an account". Anything that writes real data checks this instead.
    function isAuthor() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isTeamManager(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids.hasAny([request.auth.uid]);
    }

    // Helpers for validating per-event ownership on the array-based gameEvents.events field.
    // Firestore rules can't loop over a dynamic-length list, so these only validate the
    // common single-event mutation shapes (delete one event / edit-or-vote on one event);
    // pure additions (e.g. bulk-saving newly recorded events) are left unrestricted since
    // ownership of newly-created data isn't the concern this guards against.
    function gameEventsAdded() {
      return request.resource.data.events.removeAll(resource.data.events);
    }

    function gameEventsRemoved() {
      return resource.data.events.removeAll(request.resource.data.events);
    }

    // Removing exactly one event you authored, with nothing else added. "Verified" is a latch:
    // once a moderator signs off on an event, its author can no longer remove it.
    function isOwnUnverifiedEventDelete() {
      let removed = gameEventsRemoved();
      return gameEventsAdded().size() == 0 && removed.size() == 1 &&
             removed[0].userId == request.auth.uid &&
             removed[0].status != 'verified';
    }

    // Changing exactly one event you authored, in place. The author may not move `status`
    // themselves — verifying is a moderator action — and may not touch a verified event at all.
    function isOwnUnverifiedEventEdit() {
      let added = gameEventsAdded();
      let removed = gameEventsRemoved();
      return added.size() == 1 && removed.size() == 1 &&
             added[0].id == removed[0].id &&
             added[0].userId == removed[0].userId &&
             removed[0].userId == request.auth.uid &&
             removed[0].status != 'verified' &&
             added[0].status == removed[0].status;
    }

    // Voting, which anyone may do on anyone's event, including anonymous sessions. Only the
    // vote fields may move, and only the caller's own uid may enter or leave the arrays —
    // enforceable now that every visitor has a uid instead of a localStorage device id.
    function isVoteOnlyChange() {
      let added = gameEventsAdded();
      let removed = gameEventsRemoved();
      return added.size() == 1 && removed.size() == 1 &&
             added[0].id == removed[0].id &&
             added[0].diff(removed[0]).affectedKeys()
               .hasOnly(['votes', 'upvotes', 'downvotes', 'upvoterIds', 'downvoterIds', 'lastVoteAt']) &&
             added[0].upvoterIds.toSet().difference(removed[0].upvoterIds.toSet()).hasOnly([request.auth.uid]) &&
             removed[0].upvoterIds.toSet().difference(added[0].upvoterIds.toSet()).hasOnly([request.auth.uid]) &&
             added[0].downvoterIds.toSet().difference(removed[0].downvoterIds.toSet()).hasOnly([request.auth.uid]) &&
             removed[0].downvoterIds.toSet().difference(added[0].downvoterIds.toSet()).hasOnly([request.auth.uid]);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidGame(data) {
      return data.id is string && data.id.size() > 0 &&
             (data.seasonId == null || data.seasonId is string) &&
             (data.homeTeamId == null || data.homeTeamId is string) &&
             (data.awayTeamId == null || data.awayTeamId is string) &&
             (data.authorTeamId == null || data.authorTeamId is string) &&
             (data.isVerified == null || data.isVerified is bool) &&
             (data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidVideo(data) {
      return data.videoId is string && data.videoId.size() > 0 &&
             (data.youtubeId == null || data.youtubeId is string) &&
             (data.gameId == null || data.gameId is string) &&
             (data.title == null || data.title is string) &&
             (data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidEvent(data) {
      return data.videoId is string && data.gameId is string &&
             data.userId is string &&
             data.type is string &&
             data.videoTime is number &&
             data.votes is number &&
             data.status is string &&
             (data.createdAt == null || data.createdAt is timestamp) &&
             (!('teamId' in data) || data.teamId == null || data.teamId is string);
    }

    function isValidPlayer(data) {
      return (data.firstName == null || data.firstName is string) &&
             (data.lastName == null || data.lastName is string) &&
             (data.preferredName == null || data.preferredName is string) &&
             (data.nickname == null || data.nickname is string) &&
             (data.gender == null || data.gender in ['M', 'W', 'NB']) &&
             (data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidTeam(data) {
      return hasOnlyAllowedFields(['name', 'nickname', 'colorPrimary', 'colorDark', 'colorLight', 'colorPrimaryDark', 'colorPrimaryLight', 'colorAccent', 'memberUids', 'leagueId', 'division', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('nickname' in data) || data.nickname == null || data.nickname is string) &&
             (!('colorPrimary' in data) || data.colorPrimary is string) &&
             (!('colorDark' in data) || data.colorDark is string) &&
             (!('colorLight' in data) || data.colorLight is string) &&
             (!('colorPrimaryDark' in data) || data.colorPrimaryDark is string) &&
             (!('colorPrimaryLight' in data) || data.colorPrimaryLight is string) &&
             (!('colorAccent' in data) || data.colorAccent is string) &&
             (!('memberUids' in data) || data.memberUids is list) &&
             (!('leagueId' in data) || data.leagueId is string) &&
             (!('division' in data) || data.division is string);
    }

    function isValidSeason(data) {
      return (data.name is string && data.name.size() > 0 && data.name.size() < 100) &&
             (data.createdAt == null || data.createdAt is timestamp) &&
             (!('id' in data) || data.id is string) &&
             (!('league' in data) || data.league is string) &&
             (!('year' in data) || data.year is string) &&
             (!('description' in data) || data.description is string);
    }

    function isValidRoster(data) {
      return hasOnlyAllowedFields(['teamId', 'seasonId', 'createdAt']) &&
             data.teamId is string && data.seasonId is string;
    }

    function isValidRosterPlayer(data) {
      return hasOnlyAllowedFields(['playerId', 'number', 'createdAt']) &&
             data.playerId is string && data.number is string;
    }

    // Aggregated Stats & Lists
    match /aggregated/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Games
    match /games/{gameId} {
      allow read: if true;
      allow create: if isModerator() && isValidGame(request.resource.data);
      allow update: if isModerator() && isValidGame(request.resource.data);
      allow delete: if isAdmin();
    }

    // Videos
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isModerator() && isValidVideo(request.resource.data);
      allow update: if isModerator() && isValidVideo(request.resource.data);
      allow delete: if isAdmin();
    }

    // Players
    match /players/{playerId} {
      allow read: if true;
      allow create: if isModerator() && isValidPlayer(request.resource.data);
      allow update: if isModerator() && isValidPlayer(request.resource.data);
      allow delete: if isAdmin();
    }

    // Required for collectionGroup('players') queries
    match /{path=**}/players/{playerId} {
      allow read: if true;
    }

    // Teams
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAdmin() && isValidTeam(request.resource.data);
      allow update: if (isModerator() || isTeamManager(teamId)) && isValidTeam(request.resource.data);
      allow delete: if isAdmin();
    }

    // Leagues
    match /leagues/{leagueId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

    // Seasons
    match /seasons/{seasonId} {
      allow read: if true;
      allow create: if isModerator() && isValidSeason(request.resource.data);
      allow update: if isModerator() && isValidSeason(request.resource.data);
      allow delete: if isModerator();
    }

    // Rosters
    match /rosters/{rosterId} {
      allow read: if true;
      allow create: if (isModerator() || isTeamManager(request.resource.data.teamId)) && isValidRoster(request.resource.data);
      allow update: if (isModerator() || isTeamManager(request.resource.data.teamId)) && isValidRoster(request.resource.data);
      allow delete: if isAdmin();

      match /players/{playerId} {
        allow read: if true;
        allow create: if isModerator() && isValidRosterPlayer(request.resource.data);
        allow update: if isModerator() && isValidRosterPlayer(request.resource.data);
        allow delete: if isModerator();
      }
    }

    // Events (Legacy)
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Role Assignments & System Config
    match /appConfig/{docId} {
      allow read: if true;
      // Public read is fine now that this holds uids and no addresses. Only the admin may
      // grant moderator access — a moderator promoting other moderators is not in the model.
      allow create, update, delete: if isAdmin();
    }

    // GameEvents (Modern Array-Based Schema)
    // Read is public — current-season privacy is enforced in the app layer via dashboardGames/dashboardEvents.
    // Deleting/editing an individual event (a rewrite of the events array) is restricted to
    // the event's own author or a moderator — see issue #16. Verified events are frozen to
    // their author until a moderator unverifies them.
    match /gameEvents/{gameId} {
      allow read: if true;
      allow create: if isAuthor();
      allow update: if isModerator() ||
        // Authors record and maintain their own events. Pure appends stay unrestricted so
        // bulk saves keep working; the guard that matters is that anonymous sessions cannot
        // reach this branch at all.
        (isAuthor() && (gameEventsRemoved().size() == 0 || isOwnUnverifiedEventDelete() || isOwnUnverifiedEventEdit())) ||
        // Anyone, including anonymous sessions, may vote.
        (isAuthenticated() && isVoteOnlyChange());
      allow delete: if isAdmin();
    }

    // Votes
    match /events/{eventId}/votes/{voteId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
